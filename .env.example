# 只给脱机调试壳子（service/）用。
# 生产环境不需要这个文件——插件的配置全在 MoviePilot 的插件配置界面里填。
#
# 用法：cp .env.example .env 并填入真实值。.env 不进仓库（见 .gitignore）。

# Jimaku API Token，在 https://jimaku.cc/profile 申请
# 注意：调用时直接放进 Authorization 头，不带 "Bearer " 前缀
JIMAKU_API_TOKEN=

# 番剧库根目录，逗号分隔。填到番剧那一层，别填媒体库总根目录
# （否则下载目录、电影库都会被扫进来）
MEDIA_ROOTS=/媒体/日番

# true = 只打印将要做的操作，不实际写盘
DRY_RUN=true

# 只处理这些剧（tmdb_id，逗号分隔）。留空 = 不限制
SERIES_WHITELIST=

# 片源偏好，优先级从高到低。只在语言纯度相同时用来打破平局
FANSUB_WHITELIST=Netflix,Amazon,SubsPlease,Moozzi2

# 落盘时的语言后缀，Jellyfin 靠它识别语言（ISO 639-1）
SUBTITLE_LANG_SUFFIX=ja

# 路径映射：只有把 core/ 跑在和媒体库不同的机器上时才需要
# 插件模式下用不到（插件与 MoviePilot 同进程，看到的就是同一套路径）
PATH_MAPPING_FROM=
PATH_MAPPING_TO=
